%%{init: {'theme': 'base', 'themeVariables': {'primaryColor': '#4F46E5'}}}%%

classDiagram
    class User {
        +UUID id
        +String email
        +String full_name
        +String hashed_password
        +String role
        +Boolean is_active
        +DateTime created_at
        +DateTime updated_at
        +create_project(data) Project
        +get_projects() List~Project~
    }

    class Project {
        +UUID id
        +UUID owner_id
        +String name
        +String description
        +String target_users
        +String platform
        +JSONB preferred_tech
        +String constraints
        +String complexity
        +String status
        +String current_stage
        +Integer progress
        +DateTime created_at
        +DateTime updated_at
        +start_workflow() void
        +update_progress() void
    }

    class AIOrchestrator {
        +AsyncSession db
        +UUID project_id
        +WebSocketManager websocket_manager
        +start_workflow() void
        +_execute_stage(stage_name, agent_role, description) void
        +_simulate_agent_output(stage_name, agent_role) dict
        +_store_stage_output(stage_name, output) void
        +get_project() Project
        +get_or_create_agent(role) Agent
    }

    class Agent {
        +UUID id
        +String name
        +String role
        +String description
        +JSONB capabilities
        +Boolean is_active
        +DateTime created_at
        +execute_task(task) TaskRun
    }

    class AgentRole {
        <<enumeration>>
        REQUIREMENTS = "requirements_analyst"
        RESEARCHER = "researcher"
        PRODUCT_STRATEGIST = "product_strategist"
        ARCHITECT = "architect"
        DATABASE_ENGINEER = "database_engineer"
        UI_UX_DESIGNER = "ui_ux_designer"
        DEVELOPER = "developer"
        TESTER = "testing_engineer"
        SECURITY_REVIEWER = "security_reviewer"
        DOCUMENTATION = "documentation_engineer"
    }

    class Task {
        +UUID id
        +UUID project_id
        +UUID agent_id
        +String title
        +String description
        +String stage
        +String status
        +Integer priority
        +JSONB input_data
        +JSONB output_data
        +String error_message
        +Boolean requires_approval
        +UUID approval_id
        +DateTime created_at
        +DateTime started_at
        +DateTime completed_at
        +start() void
        +complete(output) void
        +fail(error) void
    }

    class TaskStatus {
        <<enumeration>>
        QUEUED = "queued"
        IN_PROGRESS = "in_progress"
        COMPLETED = "completed"
        FAILED = "failed"
        PENDING_APPROVAL = "pending_approval"
        CANCELLED = "cancelled"
    }

    class TaskRun {
        +UUID id
        +UUID task_id
        +UUID agent_id
        +String status
        +JSONB input_data
        +JSONB output_data
        +String error_message
        +Integer duration_ms
        +Integer tokens_used
        +DateTime started_at
        +DateTime completed_at
    }

    class Approval {
        +UUID id
        +UUID project_id
        +String action
        +String reason
        +String risk_level
        +String expected_result
        +String status
        +String decision
        +String decision_notes
        +DateTime decided_at
        +DateTime created_at
        +approve(notes) void
        +reject(notes) void
    }

    class StageStatus {
        <<enumeration>>
        PENDING = "pending"
        IN_PROGRESS = "in_progress"
        COMPLETED = "completed"
        FAILED = "failed"
        WAITING_APPROVAL = "waiting_approval"
    }

    class Document {
        +UUID id
        +UUID project_id
        +String title
        +String doc_type
        +String content
        +String format
        +Integer version
        +DateTime created_at
        +DateTime updated_at
    }

    class ProjectStage {
        +UUID id
        +UUID project_id
        +String stage_name
        +String status
        +DateTime started_at
        +DateTime completed_at
        +JSONB output_data
        +String error_message
        +mark_complete(output) void
    }

    class ConnectionManager {
        +Dict~String, List~WebSocket~~ active_connections
        +connect(websocket, project_id) void
        +disconnect(websocket, project_id) void
        +broadcast(project_id, message) void
    }

    User "1" --> "*" Project : owns
    Project "1" --> "*" ProjectStage : has
    Project "1" --> "*" Task : has
    Project "1" --> "*" Document : produces
    Project "1" --> "*" Approval : requests
    Agent "1" --> "*" Task : assigned_to
    Agent "1" --> "*" TaskRun : executes
    Task "1" --> "*" TaskRun : has
    Task "1" --> "0..1" Approval : may_require
    AIOrchestrator --> Agent : manages
    AIOrchestrator --> ProjectStage : orchestrates
    AIOrchestrator --> Task : creates
    AgentRole ..> Agent : defines
    TaskStatus ..> Task : classifies
    StageStatus ..> ProjectStage : classifies
    ConnectionManager --> Project : monitors
